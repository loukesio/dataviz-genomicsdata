# Copy this file to .env and fill in your key.  python-dotenv loads it on import.

# Required — the LLM provider API key.
PLOTPY_API_KEY=

# Optional — provider endpoint (default: Groq's OpenAI-compatible API).
# Swap to any OpenAI-compatible base_url:
#   Groq      → https://api.groq.com/openai/v1
#   OpenAI    → https://api.openai.com/v1
#   Together  → https://api.together.xyz/v1
#   Fireworks → https://api.fireworks.ai/inference/v1
#   Ollama    → http://localhost:11434/v1
PLOTPY_BASE_URL=https://api.groq.com/openai/v1

# Optional — model name (default: llama-3.3-70b-versatile on Groq).
# Examples:
#   Groq      → llama-3.3-70b-versatile  | mixtral-8x7b-32768
#   OpenAI    → gpt-4o-mini              | gpt-4o
#   Together  → meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
#   Ollama    → llama3.1                 | qwen2.5
PLOTPY_MODEL=llama-3.3-70b-versatile
